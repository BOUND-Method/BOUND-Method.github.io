{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bound-method.github.io/docs/project/schemas/documentation-contract.schema.json",
  "title": "BOUND Documentation Contract",
  "description": "Machine-checkable contract for documentation page classification, claim policy, required metadata, and structural requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "defaults", "domains"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "project": {"type": "string", "const": "BOUND Method documentation website"},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_metadata"],
      "properties": {
        "required_metadata": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["title", "description"]}
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path_prefix", "document_type", "claim_policy", "required_markers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "path_prefix": {"type": "string", "minLength": 1},
          "document_type": {
            "type": "string",
            "enum": ["site-index", "method", "guide", "reference", "example", "agent-guidance", "research", "project"]
          },
          "claim_policy": {
            "type": "string",
            "enum": [
              "method-definition",
              "practical-guidance",
              "proposed-reference",
              "illustrative-example",
              "conceptual-agent-guidance",
              "research-no-unsupported-results",
              "project-status"
            ]
          },
          "required_markers": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
